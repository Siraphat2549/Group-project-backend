# Copy to .env and fill in real values. NEVER commit .env.
#   cp .env.example .env

# ---- App ----
NODE_ENV=development
PORT=3000
# Comma-separated allowed origins. Empty = allow all (dev only).
CORS_ORIGIN=
# Per-dependency timeout for GET /health (ms)
HEALTH_CHECK_TIMEOUT_MS=3000
# Number of reverse proxies (nginx, load balancer) in front of the API.
# 0 = clients connect directly. Needed so rate limiting sees the real client IP.
TRUST_PROXY=0

# ---- MySQL (used by docker-compose to create the DB) ----
# Use URL-safe characters in passwords (no @ : / # ?), they're embedded in DATABASE_URL.
MYSQL_DATABASE=hotel_booking
MYSQL_USER=hotel
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_HOST_PORT=3306

# Connection string for running the API on the host (npm run start:dev).
# docker-compose overrides this to point at the `mysql` service.
DATABASE_URL=mysql://hotel:change-me@localhost:3306/hotel_booking

# ---- Redis ----
# Use rediss:// for TLS (managed cloud Redis). Auth: redis://:password@host:6379
REDIS_HOST_PORT=6379
REDIS_URL=redis://localhost:6379

# ---- Auth (JWT) ----
# At least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
# Access-token lifetime: seconds (900) or number + s/m/h/d (15m, 1h, 7d)
JWT_EXPIRES_IN=1h
# bcrypt cost factor for password hashes (4-15). 12 is about 250 ms per hash.
BCRYPT_ROUNDS=12

# ---- Room image uploads ----
# Directory for uploaded room images, served at /uploads/rooms/<file>
UPLOAD_DIR=uploads

# ---- Caching (Redis) ----
# Lifetime of cached room list / detail / search responses. 0 = caching off.
CACHE_TTL_SECONDS=60

# ---- Rate limiting (per client IP, per route) ----
# Window length in ms, then the max requests per window for each tier.
THROTTLE_TTL_MS=60000
# every route
THROTTLE_LIMIT=120
# POST /auth/register, POST /auth/login, PATCH /users/me
THROTTLE_AUTH_LIMIT=10
# POST /bookings
THROTTLE_BOOKING_LIMIT=20

# ---- Container start-up (docker-entrypoint.sh) ----
# Apply pending Prisma migrations before the API starts.
RUN_MIGRATIONS=true
# Create the seed accounts + sample rooms if they do not exist yet.
RUN_SEED=false

# ---- Seed accounts (npm run seed / RUN_SEED=true) ----
# Optional in development (defaults: admin@hotel.test / Admin12345 and
# user@hotel.test / User12345). REQUIRED when NODE_ENV=production.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
# true = overwrite the passwords of existing seed accounts
SEED_RESET_PASSWORDS=false
