      "description": "View and update your own profile (FR-3, FR-4)"
    },
    {
      "name": "Rooms",
      "description": "List / view rooms with images; create, edit, deactivate and image upload are Admin-only (FR-8–16)"
    },
    {
      "name": "Bookings",
      "description": "Create and view your own bookings; Admin sees all and changes status (FR-17–26)"
    },
    {
      "name": "Search",
      "description": "Rooms actually available for a date range and capacity (FR-27–29)"
    },
    {
      "name": "Notifications",
      "description": "Booking created / cancelled events for the frontend (FR-30, FR-31)"
    },
    {
      "name": "Health",
      "description": "Health check for monitoring and deployment (FR-36)"
    }
  ],
